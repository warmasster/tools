{
  "manifest_version": 3,
  "name": "TurboVAULT",
  "version": "1.0.5",
  "description": "Rellena las contraseñas y tarjetas que guardas en TurboVAULT, cifradas en tu PC. Nada sale de tu equipo.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "contextMenus", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["payhosts.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TurboVAULT",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/locked-16.png", "24": "icons/locked-24.png", "32": "icons/locked-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "commands": {
    "fill": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Rellenar usuario y contraseña"
    }
  }
}
