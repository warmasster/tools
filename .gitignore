# Ejecutables y artefactos de compilación (los .exe van en las Releases)
*.exe
**/build/bin/
**/frontend/wailsjs/
*.syso
*.tmp

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# TurboDL: copia de la extensión que build.ps1 mete dentro de TurboDL.exe
turbodl/native/ext/*
!turbodl/native/ext/LEEME.txt

# TurboBLOCK: extensión comprimida que build.ps1 mete en TurboBLOCK.exe, reglas
# compiladas (se generan con build.ps1) y caché de listas descargadas
turboblock/native/ext/*
!turboblock/native/ext/LEEME.txt
turboblock/rules/
turboblock/_metadata/
turboblock/native/.cache/

# Salida local de .github/scripts/release.ps1 -OutDir dist
dist/

# TurboMENU: hojas de iconos generadas (se rehacen con dev/icons)
turbomenu/dev/icons/*.png
turbomenu/dev/icons/icons.html
turbomenu/dev/icons/layout.json

# TurboGAMES: hoja intermedia del icono (se rehace con dev/icons/genapp.go)
turbogames/dev/icons/appsheet.png
